rules_version = '2';

// Who can do what (three portals):
// - Customers (anyone): read business settings, cleaner first names and which
//   time blocks are taken; create a new online booking for a free time.
//   Signed in with their email, they can also see their own bookings and ask
//   to cancel or change one. Nothing else.
// - Cleaners (staff entry with role "cleaner" + employeeId): see only jobs
//   they're assigned to, mark them done, and clock themselves in and out.
// - Office/owner (staff entry with role "owner" or "staff"): everything.
//   Only "owner" can change who has access.
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function authEmail() {
      return request.auth.token.email.lower();
    }
    function staffPath() {
      return /databases/$(database)/documents/staff/$(authEmail());
    }
    function isStaff() {
      return verified() && exists(staffPath());
    }
    function role() {
      return get(staffPath()).data.role;
    }
    function isOffice() {
      return isStaff() && role() in ['owner', 'staff'];
    }
    function isOwner() {
      return isStaff() && role() == 'owner';
    }
    function isCleaner() {
      return isStaff() && role() == 'cleaner';
    }
    function myEmp() {
      return get(staffPath()).data.employeeId;
    }
    function holdPath(id) {
      return /databases/$(database)/documents/holds/$(id);
    }

    function validCustomer(c) {
      return c is map
        && c.keys().hasOnly(['name', 'phone', 'email', 'address', 'access'])
        && c.keys().hasAll(['name', 'phone', 'email', 'address', 'access'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 100
        && c.phone is string && c.phone.size() >= 7 && c.phone.size() <= 30
        && c.email is string && c.email.size() <= 120
        && c.address is string && c.address.size() > 0 && c.address.size() <= 200
        && c.access is string && c.access.size() <= 300;
    }

    // A customer's booking: one cleaner, during that cleaner's working
    // hours, not in the past, and claiming its time blocks in the same write.
    function validPublicJob() {
      let d = request.resource.data;
      let cleanerPath = /databases/$(database)/documents/publicCleaners/$(d.staff[0]);
      let c = get(cleanerPath).data;
      let parts = d.date.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      let last = d.holds.size() - 1;
      return d.keys().hasOnly(['source', 'status', 'date', 'start', 'startMin', 'duration', 'blockMins',
                               'service', 'staff', 'customer', 'notes', 'holds', 'createdAt', 'clientEmail'])
        && d.get('clientEmail', '') == d.customer.email.lower()
        && d.source == 'online' && d.status == 'new'
        && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.start is string && d.start.matches('[0-9]{2}:[0-9]{2}')
        && d.startMin is int && d.startMin >= 0 && d.startMin < 1440
        && d['duration'] is number && d['duration'] > 0 && d['duration'] <= 10
        && d.blockMins is int && d.blockMins >= d['duration'] * 60 && d.blockMins <= d['duration'] * 60 + 75
        && d['service'] is string && d['service'].size() > 0 && d['service'].size() <= 80
        && d.notes is string && d.notes.size() <= 1000
        && d.staff is list && d.staff.size() == 1
        && c.active == true
        && (day.dayOfWeek() % 7) in c.days
        && d.startMin >= c.fromMin && d.startMin + d['duration'] * 60 <= c.toMin
        && day > request.time - duration.value(1, 'd')
        && validCustomer(d.customer)
        && d.createdAt == request.time
        && d.holds is list && d.holds.size() * 15 == d.blockMins
        && d.holds[0] == d.staff[0] + '_' + d.date + '_' + string(d.startMin)
        && d.holds[last] == d.staff[0] + '_' + d.date + '_' + string(d.startMin + d.blockMins - 15)
        && existsAfter(holdPath(d.holds[0]))
        && existsAfter(holdPath(d.holds[last]));
    }

    // A time block claimed by a customer booking being created in the same write.
    function validPublicHold(id) {
      let d = request.resource.data;
      let job = getAfter(/databases/$(database)/documents/jobs/$(d.jobId)).data;
      return d.keys().hasOnly(['jobId', 'cleanerId', 'date', 't'])
        && d.t is int
        && id == d.cleanerId + '_' + d.date + '_' + string(d.t)
        && job.source == 'online' && job.status == 'new'
        && job.createdAt == request.time
        && job.staff[0] == d.cleanerId && job.date == d.date
        && d.t >= job.startMin && d.t < job.startMin + job.blockMins
        && (d.t - job.startMin) % 15 == 0;
    }

    // A cleaner marking their own scheduled job done. Nothing else changes.
    function cleanerMarksDone() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(['status', 'updatedAt', 'doneAt', 'doneBy'])
        && resource.data.status == 'scheduled' && request.resource.data.status == 'done';
    }
    // A customer asking to cancel or change one of their upcoming bookings.
    function customerRequest() {
      let r = request.resource.data.request;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['request'])
        && resource.data.status in ['new', 'scheduled']
        && r is map && r.keys().hasOnly(['type', 'note', 'at'])
        && r.type in ['cancel', 'change']
        && r.note is string && r.note.size() <= 500
        && r.at == request.time;
    }
    function ownsBooking() {
      return verified() && resource.data.get('clientEmail', '') == authEmail();
    }
    function assignedToMe() {
      return isCleaner() && myEmp() in resource.data.get('staff', []);
    }

    match /public/{doc} {
      allow read: if true;
      allow write: if isOffice();
    }
    match /publicCleaners/{id} {
      allow read: if true;
      allow write: if isOffice();
    }
    match /holds/{id} {
      allow read: if true;
      // "create" only applies when the block is free: claiming a taken block is an update, which customers can't do.
      allow create: if isOffice() || validPublicHold(id);
      allow update, delete: if isOffice();
    }
    match /jobs/{id} {
      allow read: if isOffice() || assignedToMe() || ownsBooking();
      allow create: if isOffice() || validPublicJob();
      allow update: if isOffice()
        || (assignedToMe() && cleanerMarksDone())
        || (ownsBooking() && customerRequest());
      allow delete: if isOffice();
    }
    match /clients/{id} {
      allow read, write: if isOffice();
    }
    match /employees/{id} {
      allow read: if isOffice() || (isCleaner() && id == myEmp());
      allow write: if isOffice();
    }
    match /shifts/{id} {
      allow read: if isOffice() || (isCleaner() && resource.data.employeeId == myEmp());
      allow create: if isOffice()
        || (isCleaner() && request.resource.data.employeeId == myEmp()
            && request.resource.data.keys().hasOnly(['employeeId', 'in', 'out', 'note']));
      allow update: if isOffice()
        || (isCleaner() && resource.data.employeeId == myEmp()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['out', 'note']));
      allow delete: if isOffice();
    }
    match /staff/{email} {
      allow read: if isOffice() || (verified() && email == authEmail());
      allow write: if isOwner();
    }
  }
}
